<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BookingApp.MainPage"
             Title="GreenBay BookingApp"
             BackgroundColor="#64DF89">

    <Grid RowDefinitions="Auto,*" Padding="15">
        <!-- Header with Title -->
        <Border Grid.Row="0" 
                BackgroundColor="#8F4A56" 
                Padding="10" 
                StrokeThickness="0">
            <Label Text="Green Bay Booking System" 
                   TextColor="#4A8F83" 
                   FontSize="22" 
                   HorizontalOptions="Center" 
                   FontAttributes="Bold"/>
        </Border>

        <!-- Time and Date information -->
        <VerticalStackLayout Grid.Row="1" Spacing="5" Padding="0,20,0,0">
            <Label x:Name="TimeLabel" 
                   Text="Time: 14:31" 
                   TextColor="Black"
                   FontSize="18"/>

            <Label x:Name="DateLabel" 
                   Text="Date: 19/03/2025" 
                   TextColor="Black"
                   FontSize="18"/>

            <Label x:Name="DayLabel" 
                   Text="Day: Wednesday" 
                   TextColor="Black"
                   FontSize="18"/>

            <!-- Buttons Stack -->
            <VerticalStackLayout Spacing="20" Margin="0,30,0,0">
                <Button x:Name="CheckBookingsBtn"
                        Text="Check Bookings ✓" 
                        SemanticProperties.Hint="Brings you to Check Bookings Page"
                        Clicked="OnCheckBookBtn"
                        BackgroundColor="#8F4A56"
                        TextColor="White"
                        FontSize="18"
                        HeightRequest="60"
                        CornerRadius="30"/>

                <Button x:Name="MakeABookingBtn"
                        Text="Make a Booking +" 
                        SemanticProperties.Hint="Brings you to Make a Booking Page"
                        Clicked="OnMakeABookBtn"
                        BackgroundColor="#8F4A56"
                        TextColor="White"
                        FontSize="18"
                        HeightRequest="60"
                        CornerRadius="30"/>

                <Button x:Name="UpdateBookingBtn"
                        Text="Update Booking ✏️" 
                        SemanticProperties.Hint="Brings you to Update Bookings Page"
                        Clicked="OnUpdateBookBtn"
                        BackgroundColor="#8F4A56"
                        TextColor="White"
                        FontSize="18"
                        HeightRequest="60"
                        CornerRadius="30"/>

                <Button x:Name="SettingsBtn"
                        Text="Settings ⚙️" 
                        SemanticProperties.Hint="Brings you to Settings Page"
                        Clicked="OnSettingsBtn"
                        BackgroundColor="#8F4A56"
                        TextColor="White"
                        FontSize="18"
                        HeightRequest="60"
                        CornerRadius="30"/>
                
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Grid>

</ContentPage>
