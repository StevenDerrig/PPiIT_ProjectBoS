<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BookingApp.CheckBookingPage"
             Title="Check Booking Page"
             BackgroundColor="#64DF89">

    <Grid RowDefinitions="Auto,*" Padding="15">
        <!-- Header with Title -->
        <Border Grid.Row="0" 
                BackgroundColor="#8F4A56" 
                Padding="10" 
                StrokeThickness="0">
            <Label Text="Check Bookings" 
                   TextColor="#4A8F83" 
                   FontSize="22" 
                   HorizontalOptions="Center" 
                   FontAttributes="Bold"/>
        </Border>

    </Grid>

</ContentPage>